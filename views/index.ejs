<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prefix Generator</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Prefix Generator</h1>

    <!-- Search Form -->
    <form action="/search" method="post">
        <label for="searchTerm">Search:</label>
        <input type="text" id="searchTerm" name="searchTerm" placeholder="Enter word, meaning, or example">
        <button type="submit">Search</button>
    </form>

    <!-- Prefix Form -->
    <form action="/generate" method="post">
        <label for="prefix">Enter Prefix:</label>
        <input type="text" id="prefix" name="prefix" value="<%= prefix %>">
        <button type="submit">Generate</button>
    </form>

    <% if (words.length > 0) { %>
        <h2>Results</h2>
        <table>
            <tr>
                <th>Word</th>
                <th>Meaning</th>
                <th>Example</th>
                <th>Actions</th>
            </tr>
            <% words.forEach(function(word) { %>
                <tr>
                    <td><%= word.Word %></td>
                    <td><%= word.Meaning %></td>
                    <td><%= word.Example %></td>
                    <td>
                        <form action="/edit-example" method="post" style="display:inline;gap: 10px">
                            <input type="hidden" name="word" value="<%= word.Word %>">
                            <input type="text" name="updatedExample" placeholder="New Example" required>
                            <input type="text" name="updatedMeaning" placeholder="New Meaning" required>
                            <button type="submit">Edit</button>
                        </form>
                        <form action="/delete-example" method="post" style="display:inline;gap: 10px">
                            <input type="hidden" name="word" value="<%= word.Word %>">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </table>

        <h3>Add New Example and Meaning</h3>
        <form action="/add-example" method="post">
            <label for="word">Word:</label>
            <input type="text" id="word" name="word" required>
            <label for="newMeaning">Meaning:</label>
            <input type="text" id="newMeaning" name="newMeaning" required>
            <label for="newExample">Example:</label>
            <input type="text" id="newExample" name="newExample" required>
            <button type="submit">Add Example</button>
        </form>
    <% } %>
</body>
</html>

